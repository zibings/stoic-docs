{
	"name": "front",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"tokens": "node ../shared/scripts/build-tokens.mjs",
		"dev": "pnpm tokens && vite --host",
		"preview": "vite preview",
		"build": "run-s tokens type-check ssg:build",
		"build:only": "pnpm tokens && vite build",
		"ssg:build": "cross-env VITE_ENV_MODE=ssg vite-ssg build",
		"test:unit": "pnpm tokens && vitest run",
		"type-check": "vue-tsc --build --force",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
		"format": "prettier --write src/",
		"zsf": "cross-env APP_TARGET=../../web VITE_ENV_MODE=ssg run-s tokens type-check clean:web ssg:build",
		"clean:web": "node scripts/clean-web.mjs"
	},
	"dependencies": {
		"@docs/shared": "workspace:*",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@unhead/vue": "^2.1.17",
		"axios": "^1.20.0",
		"highlight.js": "^11.12.0",
		"markdown-it": "^15.0.2",
		"markdown-it-container": "^4.0.0",
		"minisearch": "^7.2.0",
		"pinia": "^4.0.3",
		"primevue": "^4.5.5",
		"vite-ssg": "^28.3.0",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"@ctd1500/eslint-config": "^0.2.0",
		"@tsconfig/node22": "^22.0.6",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.3",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"beasties": "^0.5.4",
		"cross-env": "^10.1.0",
		"eslint": "^9.7.0",
		"jsdom": "^30.1.1",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"vue-tsc": "^3.3.11"
	}
}
