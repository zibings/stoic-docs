{
	"name": "admin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"tokens": "node ../shared/scripts/build-tokens.mjs",
		"dev": "pnpm tokens && vite --host --port 5174",
		"build": "run-s tokens type-check build:only",
		"build:only": "vite build",
		"test:unit": "pnpm tokens && vitest run",
		"type-check": "vue-tsc --build --force",
		"zsf": "cross-env APP_TARGET=../../web/admin run-s tokens type-check build:only"
	},
	"dependencies": {
		"@docs/shared": "workspace:*",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@primevue/themes": "^4.5.4",
		"axios": "^1.20.0",
		"pinia": "^4.0.3",
		"primeicons": "^7.0.0",
		"primevue": "^4.5.5",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"@tsconfig/node22": "^22.0.6",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.3",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"cross-env": "^10.1.0",
		"jsdom": "^30.1.1",
		"npm-run-all2": "^9.0.3",
		"typescript": "~5.9.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"vue-tsc": "^3.3.11"
	}
